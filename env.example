# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend API
PORT=3001
API_URL="http://localhost:3001"
APP_PORT=3001

# Postgres/Docker data source.
POSTGRES_USER="clinic"
POSTGRES_PASSWORD="clinic_dev_password"
POSTGRES_DB="clinic_agenda"
POSTGRES_PORT=5432
DATABASE_URL="postgres://clinic:clinic_dev_password@localhost:5432/clinic_agenda"

# Cal.com server-side integration. Never expose this token in the frontend.
CAL_API_KEY="optional_legacy_or_admin_key"
CAL_API_KEY_MARCIA="replace_with_marcia_cal_api_key"
CAL_API_KEY_FRANCISCA="replace_with_francisca_cal_api_key"
CAL_API_VERSION="2024-06-14"

# Optional n8n webhook already used by the WhatsApp workflow.
N8N_WEBHOOK_URL="https://n8n.example/webhook/cal"
